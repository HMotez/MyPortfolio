# ── Contact form API (server/) ───────────────────────────────
# Local / Docker: Gmail SMTP with an app password
# (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Inbox that receives the messages (defaults to GMAIL_USER)
CONTACT_TO=

# Production on Render: Render's free plan blocks SMTP, so use Resend's HTTP API.
# When set, it is used instead of Gmail. CONTACT_TO must be your Resend account email
# (until you verify a domain of your own on Resend).
RESEND_API_KEY=

SERVER_PORT=5000

# ── Website (Vite) ───────────────────────────────────────────
# Address of the API as seen by the browser (local dev server)
VITE_API_URL=http://localhost:5000
